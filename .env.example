# ==============================================================================
# ShopKart Environment Variables Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' in the project root or backend directory:
#      cp .env.example .env
# 2. Fill in the appropriate secrets and configuration for your target environment.
# 3. WARNING: NEVER commit the actual '.env' file containing real secrets to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Active Spring Profile & Server Settings
# ------------------------------------------------------------------------------
# Active profile: 'dev' (H2, in-memory, debug enabled) or 'prod' (PostgreSQL, Redis, hardened)
SPRING_PROFILES_ACTIVE=dev

# Backend Server Listening Port (PORT and SERVER_PORT aliases supported)
PORT=8080
SERVER_PORT=8080

# ------------------------------------------------------------------------------
# 2. Security & JWT Credentials (MANDATORY IN PRODUCTION)
# ------------------------------------------------------------------------------
# Cryptographically secure HMAC-SHA256 secret key (at least 256 bits / 32 bytes or 64 hex characters)
# Example generation: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_256_bit_random_hex_or_base64_secret_key_in_production

# JWT Expiration Period in milliseconds (86400000 ms = 24 hours)
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# 3. Payment Gateway Sandbox Credentials (Razorpay)
# ------------------------------------------------------------------------------
# Sandbox Key ID, Secret, and Webhook Secret (bound to PAYMENT_SANDBOX_* and RAZORPAY_KEY_*)
PAYMENT_SANDBOX_KEY=rzp_test_yourSandboxKeyIdHere
PAYMENT_SANDBOX_SECRET=yourSandboxKeySecretHere
PAYMENT_WEBHOOK_SECRET=yourWebhookSecretHere

# Razorpay Alternative Variable Names
RAZORPAY_KEY_ID=rzp_test_yourSandboxKeyIdHere
RAZORPAY_KEY_SECRET=yourSandboxKeySecretHere
RAZORPAY_WEBHOOK_SECRET=yourWebhookSecretHere

# ------------------------------------------------------------------------------
# 4. Database Configuration (PostgreSQL for Production / H2 for Development)
# ------------------------------------------------------------------------------
# Primary Database Connection Variables (Supported as DB_* or SPRING_DATASOURCE_*)
DB_URL=jdbc:postgresql://localhost:5432/shopkart
DB_USERNAME=postgres
DB_PASSWORD=your_strong_postgres_password_here

# Spring Boot Standard Datasource Aliases
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/shopkart
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_strong_postgres_password_here

# Hibernate DDL Auto: 'update' for dev; 'validate' for prod
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Database Platform Dialect
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect

# Flyway Database Migrations
SPRING_FLYWAY_ENABLED=true

# ------------------------------------------------------------------------------
# 5. Caching & Redis Configuration
# ------------------------------------------------------------------------------
# Cache Provider: 'simple' (in-memory dev) or 'redis' (production)
SPRING_CACHE_TYPE=simple
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 6. File Uploads & Cloud Storage (Optional)
# ------------------------------------------------------------------------------
# Local File Upload Directory
UPLOAD_DIR=uploads

# Cloudinary Storage Configuration (Optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AWS S3 Storage Configuration (Optional)
AWS_S3_BUCKET=
AWS_S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------------------
# 7. Frontend CORS & Application Logging Settings
# ------------------------------------------------------------------------------
# Trusted Frontend Origin URL for Cross-Origin Resource Sharing (CORS)
FRONTEND_URL=http://localhost:5173

# Application & Spring Boot Logging Verbosity ('DEBUG', 'INFO', 'WARN', 'ERROR')
LOG_LEVEL=INFO

